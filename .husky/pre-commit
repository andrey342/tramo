pnpm exec lint-staged

# Reject staged content carrying the phrases listed one per line in the untracked
# .local/forbidden-words (trailers, tool names). Tooling configuration is exempt. Elsewhere, the
# tooling folder name and its conventions file are references to files, not mentions, so they are
# removed before the check.
[ -f .local/forbidden-words ] || exit 0
forbidden=$(grep -v '^[[:space:]]*$' .local/forbidden-words | paste -sd '|' -)
[ -n "$forbidden" ] || exit 0
git diff --cached --name-only --diff-filter=ACMR | {
  status=0
  while IFS= read -r f; do
    case "$f" in
      CLAUDE.md | .claude/* | .mcp.json | .husky/* | commitlint.config.mjs) continue ;;
    esac
    if git show ":$f" | sed -E 's#\.claude|CLAUDE\.md##g' | grep -qiIE "$forbidden"; then
      echo "pre-commit: forbidden attribution text in $f" >&2
      status=1
    fi
  done
  exit $status
}
