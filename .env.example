# Copy to .env. Values below work for local development against `docker compose --profile dev up`.
# Inside the compose network the api and worker override host names (see docker-compose.yml).

NODE_ENV=development
PORT=3000
WORKER_HEALTH_PORT=3100
LOG_LEVEL=info
LOG_PRETTY=true
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
# Global rate limit per client IP (authentication routes have stricter limits of their own).
# Behind a reverse proxy, set TRUST_PROXY_HOPS to the number of proxies so the real client IP is used.
TRUST_PROXY_HOPS=0
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=10

DATABASE_URL=postgres://tramo:tramo@localhost:5432/tramo
DATABASE_POOL_MAX=10
DATABASE_LOG_QUERIES=false
# The api applies pending migrations at startup when true (the compose stack sets it).
DATABASE_RUN_MIGRATIONS=false

REDIS_URL=redis://localhost:6379

# Read-only role for the Postgres MCP server (.mcp.json), which runs in a container and reaches the
# compose Postgres through host.docker.internal. Created by docker/postgres/diagnostics.sql.
# .mcp.json reads it from the environment the editor or agent was started in, not from this file;
# export it there only when Postgres is not on localhost:5432 (the value below is the default).
TRAMO_RO_DATABASE_URI=postgresql://tramo_ro:tramo_ro@host.docker.internal:5432/tramo

# Authentication. The secret below is for local development only; use a long random value elsewhere.
JWT_ACCESS_SECRET=local-development-secret-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900

# AES-256 key for encrypted columns (payout IBANs, webhook secrets), 32 bytes in base64. Local only;
# generate your own with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=K0ZDSqr9YOcVMSLG1k4+T3Ie9/nmSDRZDMoifZ6VyIU=
REFRESH_TOKEN_TTL_DAYS=30
# A session ends this many days after sign-in, however often it is refreshed.
SESSION_MAX_DAYS=90
# Progressive lockout: after LOGIN_MAX_FAILURES failed sign-ins the account waits
# LOGIN_LOCK_BASE_SECONDS, doubling with each further failure up to LOGIN_LOCK_MAX_SECONDS.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_BASE_SECONDS=60
LOGIN_LOCK_MAX_SECONDS=3600

# VAT checks of training centers. live: VIES itself; test: its test service, which knows only
# tax id 100 (valid) and 200 (invalid) and answers every other number as an outage (the check is
# retried, then dead-lettered); fake: the same table answered locally, any other number valid.
# With NODE_ENV=production only live is accepted.
VIES_MODE=test
VIES_TIMEOUT_MS=5000
# Where VIES is reached; each mode adds its own path. Point it at a stub to exercise the client.
# VIES_BASE_URL=https://ec.europa.eu/taxation_customs/vies/rest-api

# Applicants are checked by simulated KYC, employment and credit bureau providers (deterministic
# by national id: ending in 9 fails KYC, ending in 7 is in a default registry). How long they take
# to answer, min-max in milliseconds.
# Only simulated providers exist so far; a production process refuses to start with them.
VERIFICATION_PROVIDERS=simulated
SIMULATED_PROVIDER_LATENCY_MS=300-800

# Contracts are signed through a simulated e-signature provider and centers paid by a simulated
# bank (an IBAN ending in 0000 bounces). Only simulated providers exist so far; a production
# process refuses to start with them. The provider signs its callbacks to POST /webhooks/esign
# with this key (HMAC-SHA256); `pnpm esign:sign <contractId>` plays the student signing.
LENDING_PROVIDERS=simulated
ESIGN_WEBHOOK_SECRET=local-esign-webhook-secret-change-me-0123456789
# During a rotation, the secret being replaced, still accepted until the provider uses the new one.
ESIGN_WEBHOOK_PREVIOUS_SECRET=

# Students repay by SEPA direct debit through a simulated payment provider: it accepts each
# collection and answers ~SIMULATED_PSP_DELAY_MS later on POST /webhooks/psp (signed with
# PSP_WEBHOOK_SECRET); an amount ending in 13 cents is refused for insufficient funds. Only the
# simulated provider exists so far; a production process refuses to start with it.
# PSP_CALLBACK_URL is where the worker reaches the api.
PAYMENT_PROVIDER=simulated
PSP_WEBHOOK_SECRET=local-psp-webhook-secret-change-me-0123456789
PSP_WEBHOOK_PREVIOUS_SECRET=
PSP_CALLBACK_URL=http://localhost:3000
SIMULATED_PSP_DELAY_MS=2000
# Ops may run billing and dunning as of a day still to come (on by default outside production).
BILLING_FUTURE_RUNS_ENABLED=

# Emails go through SMTP: Mailpit locally (UI on :8025). SMTP_SECURE=true for TLS from the first
# byte (port 465); user and password only when the server asks for them.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Tramo <no-reply@tramo.test>

# Webhooks to training centers: one attempt's timeout, the first retry delay (doubling, five
# attempts), and whether a center may use a private address such as the compose webhook sink
# (on by default outside production).
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_RETRY_DELAY_MS=30000
WEBHOOK_PRIVATE_TARGETS_ENABLED=

# Worker: how often the outbox publisher polls when idle, and how many rows it sends per batch.
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100
# A batch Redis has not accepted within this time is rolled back and retried.
OUTBOX_ENQUEUE_TIMEOUT_MS=10000

# Bull Board at /admin/queues (basic auth). Leave the password empty to disable it.
BULL_BOARD_USERNAME=ops
BULL_BOARD_PASSWORD=tramo-queues

# Prometheus metrics at /metrics, for a bearer of this token. Leave it empty to disable them.
METRICS_TOKEN=tramo-local-metrics-token-change-me

# docker compose. `demo` starts the whole stack; `docker compose --profile dev up` overrides it
# and starts only postgres, redis, mailpit and the webhook sink.
COMPOSE_PROFILES=demo
POSTGRES_USER=tramo
POSTGRES_PASSWORD=tramo
POSTGRES_DB=tramo
