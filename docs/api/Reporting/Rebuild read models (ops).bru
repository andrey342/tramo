meta {
  name: Rebuild read models (ops)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/ops/reporting/rebuild
  body: none
  auth: bearer
}

headers {
  Idempotency-Key: {{$guid}}
}

auth:bearer {
  token: {{opsToken}}
}

docs {
  Queues a job that rebuilds the reporting read models from the event history, one at a time; answers 202 with `queued: true`, or `queued: false` while a rebuild is already queued or running. 503 `queue_unavailable` when the job queue (Redis) does not answer in time.
}
