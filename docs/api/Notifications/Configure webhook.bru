meta {
  name: Configure webhook
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/centers/{{centerId}}/webhook
  body: json
  auth: bearer
}

auth:bearer {
  token: {{centerToken}}
}

body:json {
  {
    "url": "http://webhook-sink:9099/codeworks"
  }
}

docs {
  Center admin only. Points the webhook at a URL (https outside development) and returns a new signing `secret`, shown once. Calling it again rotates the secret: for 24 hours (`previousSecretExpiresAt`) each delivery carries a second `v1` signed with the replaced secret, so the receiver accepts a request when any `v1` matches. The URL is called by the worker inside the compose network, hence the service name.
}
