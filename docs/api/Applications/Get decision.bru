meta {
  name: Get decision
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/applications/{{applicationId}}/decision
  body: none
  auth: bearer
}

auth:bearer {
  token: {{studentToken}}
}

docs {
  Why the application was decided as it was: score, weighted factors, hard rules broken, reasons and the policy version. Student, ops or admin; 404 until it is scored.
}
