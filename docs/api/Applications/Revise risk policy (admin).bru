meta {
  name: Revise risk policy (admin)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/risk-policies
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: {{$guid}}
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "maxFinanceableCents": 1200000,
    "minAgeYears": 18,
    "allowedResidenceCountries": ["ES"],
    "weightsBasisPoints": {
      "employability": 4000,
      "employmentHistory": 2500,
      "affordability": 2000,
      "bureau": 1500
    },
    "approveThreshold": 72,
    "reviewThreshold": 50
  }
}

docs {
  Admin only. Publishes the next policy version; past decisions keep theirs. Every field is optional. The body shown is the default policy with the approval threshold raised from 70 to 72; later applications are scored with it. A revision that changes no rule answers 422 `invalid_risk_policy`. Check "Current risk policy (ops)" first.
}
