{
  "name": "tramo",
  "version": "0.1.0",
  "description": "Education financing backend: applications, scoring, contracts, disbursements and collections.",
  "author": "Andrey Kuzmin <andreykuzmin342@gmail.com>",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main.api.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "format": "prettier --write \"{src,test,scripts,docs,docker,.github}/**/*.{ts,js,md,yml,yaml,json}\" \"*.{json,mjs,js,yml,yaml}\" README.md",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "format:check": "prettier --check \"{src,test,scripts,docs,docker,.github}/**/*.{ts,js,md,yml,yaml,json}\" \"*.{json,mjs,js,yml,yaml}\" README.md",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
