{
  "name": "tramo",
  "version": "0.1.0",
  "description": "Education financing backend: applications, scoring, contracts, disbursements and collections.",
  "author": "Andrey Kuzmin <andreykuzmin342@gmail.com>",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main.api.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "format": "prettier --write \"{src,test,scripts,docs,docker,.github}/**/*.{ts,js,md,yml,yaml,json}\" \"*.{json,mjs,js,yml,yaml}\" README.md",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
    "format:check": "prettier --check \"{src,test,scripts,docs,docker,.github}/**/*.{ts,js,md,yml,yaml,json}\" \"*.{json,mjs,js,yml,yaml}\" README.md",
    "prepare": "husky",
    "test:e2e": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-e2e.config.js --runInBand",
    "worker:dev": "nest start --watch --entryFile main.worker",
    "arch:check": "depcruise src test --config .dependency-cruiser.cjs --output-type err",
    "test:int": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-int.config.js --runInBand",
    "migration:run": "nest build && typeorm migration:run -d dist/src/shared/infrastructure/database/data-source.js",
    "migration:revert": "nest build && typeorm migration:revert -d dist/src/shared/infrastructure/database/data-source.js",
    "migration:show": "nest build && typeorm migration:show -d dist/src/shared/infrastructure/database/data-source.js",
    "migration:generate": "nest build && typeorm migration:generate -d dist/src/shared/infrastructure/database/data-source.js"
  },
  "dependencies": {
    "@bull-board/api": "9.10.4",
    "@bull-board/express": "9.10.4",
    "@bull-board/nestjs": "9.10.4",
    "@nestjs-cls/transactional": "4.0.1",
    "@nestjs-cls/transactional-adapter-typeorm": "2.0.1",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/typeorm": "12.0.2",
    "bullmq": "6.3.11",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "decimal.js": "10.6.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nestjs-cls": "7.0.1",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "uuidv7": "1.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@testcontainers/postgresql": "12.2.0",
    "@testcontainers/redis": "12.2.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.9",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "testcontainers": "12.2.0",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
